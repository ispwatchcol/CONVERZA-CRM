APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL pública canónica del SaaS (la que verán todos los clientes y Meta).
# La misma en cualquier entorno; reemplaza por tu dominio público.
APP_PUBLIC_URL=https://converza-crm.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción usar 'warning' como mínimo: con 'error' se pierden los Log::warning
# del webhook ("ningún tenant coincide con phone_number_id"), que son justo los que
# avisan de un problema antes de que se convierta en incidente.
LOG_LEVEL=debug
# Días de retención del log crudo de webhooks (storage/logs/webhook-raw.log).
# Es la copia de respaldo de cada mensaje entrante: si la BD se cae, es lo único
# que permite reprocesar sin perder nada.
LOG_WEBHOOK_RAW_DAYS=30

# Conexión PRINCIPAL — tablas propias de Converza (schema dedicado).
# DB_SEARCH_PATH: local=converza_dev, prod=converza.
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=converza_dev
DB_SSLMODE=require

# Conexión READ-ONLY a ispwatch (mismo Postgres, schema public).
# En el hardening de seguridad se reemplaza por un rol converza_reader con SELECT-only.
ISPWATCH_DB_HOST=aws-0-us-east-1.pooler.supabase.com
ISPWATCH_DB_PORT=5432
ISPWATCH_DB_DATABASE=postgres
ISPWATCH_DB_USERNAME=
ISPWATCH_DB_PASSWORD=
ISPWATCH_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage para medios de WhatsApp (imágenes, audios).
# MEDIA_DISK: 'public' (disco local, por defecto) | 'supabase' | 's3'
# Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
# Bucket debe ser público para que los medios se sirvan con URL directa.
MEDIA_DISK=public
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=converza-media
SUPABASE_STORAGE_ENDPOINT=

# Optimización de medios de WhatsApp
# Tipos que se descargan y almacenan en disco. Documentos de WhatsApp pueden
# pesar hasta 100MB (vs. 16MB de video) — el mayor riesgo de storage de la lista.
# media.cleanup_days (90 por defecto) borra los archivos viejos del disco periódicamente.
MEDIA_DOWNLOAD_TYPES=image,audio,video,document
# Compresión de imágenes (requiere extensión GD de PHP)
MEDIA_COMPRESS_IMAGES=true
MEDIA_MAX_WIDTH=1200
MEDIA_JPEG_QUALITY=75
# Días antes de limpiar medios antiguos del disco
MEDIA_CLEANUP_DAYS=90

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Webhook forwarder: reenvía una copia de cada webhook a otra URL (desarrollo
# local vía ngrok). DEJAR VACÍO EN PRODUCCIÓN — manda los mensajes de los clientes
# a un tercero, y los dominios ngrok gratuitos se reciclan entre cuentas.
# Ejemplo (solo local): WEBHOOK_FORWARD_URL=https://abc123.ngrok.io/webhook
WEBHOOK_FORWARD_URL=

# Correo del equipo: a dónde nos llega el aviso de que un ISP abrió un ticket
# en el portal de soporte. Necesita un transporte de correo de VERDAD; con
# MAIL_MAILER en `log` (el default de Laravel) el aviso no sale del servidor y
# queda registrado como omitido en ticket_notification_logs.
# Gmail exige contraseña de aplicación (con 2FA activo), no la del correo.
# SUPPORT_INTERNAL_EMAIL=ispwatchcol@gmail.com
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=ispwatchcol@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=ispwatchcol@gmail.com
# MAIL_FROM_NAME="Converza CRM"

# Avisos de SOPORTE al ISP (sus tickets con nosotros) — CON-57.
# Salen del número de Converza (tenant `default`), no del número de cada ISP.
# Fuera de la ventana de 24 h hacen falta plantillas aprobadas en Meta; sin
# nombre configurado el aviso se registra como omitido y NO se intenta, que es
# preferible a que Meta lo rechace en silencio y gaste quality rating.
# Las plantillas esperan dos variables nombradas: {{numero}} y {{asunto}}.
# SUPPORT_NOTIFY_LANG=es_CO
# SUPPORT_NOTIFY_TPL_ACUSE=
# SUPPORT_NOTIFY_TPL_RESPUESTA=
# SUPPORT_NOTIFY_TPL_RESUELTO=

# Cobro automático del SaaS a los ISP (Core Brain, docs/core-brain.md §8).
# Se enciende por cuenta en la ficha; esto solo configura cómo avisa.
# Cómo se paga: va al final de cada aviso de texto y en la pantalla de
# "servicio suspendido". Las plantillas de Meta llevan su propio texto fijo.
# BRAIN_BILLING_PAY_INSTRUCTIONS="Nequi 300 000 0000 a nombre de ..."
# BRAIN_BILLING_TZ=America/Bogota
# BRAIN_BILLING_NOTIFY_LANG=es_CO
# Plantillas para avisar fuera de la ventana de 24 h. Variables nombradas:
#   factura / recordatorio: {{cliente}} {{numero}} {{total}} {{vence}}
#   suspension: {{cliente}} {{total}} · reactivacion: {{cliente}}
# Sin plantilla el aviso queda omitido; la factura y el corte siguen igual.
# BRAIN_BILLING_TPL_FACTURA=
# BRAIN_BILLING_TPL_RECORDATORIO=
# BRAIN_BILLING_TPL_SUSPENSION=
# BRAIN_BILLING_TPL_REACTIVACION=
# Token con el que ispwatch consulta GET /saas/estado/{id} para cortar su panel.
# Vacío = la ruta responde 404. Generar con: php -r "echo bin2hex(random_bytes(32));"
# BRAIN_SAAS_STATUS_TOKEN=

# Flujos del bot (Workspace). Todo tiene default en config/flows.php: estas
# variables solo hacen falta para cambiarlo.
# FLOWS_QUEUE: déjalo en 'default'. Pasarlo a 'flows' SIN agregar antes el
# programa de Supervisor que escuche esa cola deja a todos los flujos mudos.
FLOWS_QUEUE=default
# FLOWS_MAX_STEPS_PER_EVENT=25
# FLOWS_MAX_STEPS_PER_RUN=200
# FLOWS_INPUT_TIMEOUT_HOURS=24
# FLOWS_DEFAULT_TIMEZONE=America/Bogota

# Inteligencia artificial: lectura de comprobantes de pago (docs/agente-ia.md).
# Interruptor general. En false nada sale al proveedor y los comprobantes quedan
# para revisión manual. Encenderlo SOLO con el worker converza-ai corriendo
# (deploy/supervisor/converza-ai.conf): sin él nada se lee.
AI_ENABLED=false
# AI_QUEUE=ai
XAI_API_KEY=
# XAI_MODEL=grok-4.3
# Si el modelo rechaza el parámetro de razonamiento (400 en ai_usage_logs), dejarlo vacío.
# XAI_REASONING_EFFORT=low
# XAI_TIMEOUT=60
# Tope de gasto por empresa y mes en USD (cada empresa puede tener el suyo en Admin → Tenants).
# AI_DEFAULT_MONTHLY_BUDGET_USD=5
# AI_RECEIPT_MIN_CONFIDENCE=0.8
# AI_RECEIPT_MAX_AGE_DAYS=7
# AI_RECEIPT_TASK_TIMEOUT=5
# AI_RECEIPT_AUTO_MAX=300000
# AI_RECEIPT_AUTO_PER_DAY=2

# API de ispwatch para registrar pagos (Converza solo LEE la base de ispwatch).
# La credencial es por empresa y se carga en Admin → Tenants; sin URL o sin
# credencial, los pagos quedan para registrarlos a mano.
# ISPWATCH_API_URL=https://ispwatch-crm.app
# ISPWATCH_API_TIMEOUT=60
