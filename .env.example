APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL pública canónica del SaaS (la que verán todos los clientes y Meta).
# La misma en cualquier entorno; reemplaza por tu dominio público.
APP_PUBLIC_URL=https://converza-crm.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Conexión PRINCIPAL — tablas propias de Converza (schema dedicado).
# DB_SEARCH_PATH: local=converza_dev, prod=converza.
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=converza_dev
DB_SSLMODE=require

# Conexión READ-ONLY a ispwatch (mismo Postgres, schema public).
# En el hardening de seguridad se reemplaza por un rol converza_reader con SELECT-only.
ISPWATCH_DB_HOST=aws-0-us-east-1.pooler.supabase.com
ISPWATCH_DB_PORT=5432
ISPWATCH_DB_DATABASE=postgres
ISPWATCH_DB_USERNAME=
ISPWATCH_DB_PASSWORD=
ISPWATCH_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage para medios de WhatsApp (imágenes, audios).
# MEDIA_DISK: 'public' (disco local, por defecto) | 'supabase' | 's3'
# Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
# Bucket debe ser público para que los medios se sirvan con URL directa.
MEDIA_DISK=public
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=converza-media
SUPABASE_STORAGE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Webhook forwarder (solo producción): reenvía los webhooks a tu local via ngrok
# Ejemplo: WEBHOOK_FORWARD_URL=https://abc123.ngrok.io/webhook
WEBHOOK_FORWARD_URL=
